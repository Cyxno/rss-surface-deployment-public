root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cmd,bat}]
end_of_line = crlf

[*.ps1]
end_of_line = crlf
charset = utf-8-bom

[*.{json,yml,yaml}]
indent_size = 2

[*.{cmd,bat}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
