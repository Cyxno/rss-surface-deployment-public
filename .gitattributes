# Normal text files: normalize to LF in the repository
* text=auto

# Windows-specific sources always CRLF
*.ps1 text eol=crlf
*.psd1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Defined LF files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
.editorconfig text eol=lf

# Never modify binaries
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.zip binary
*.wim binary
*.esd binary
*.msi binary
*.msu binary
*.iso binary
*.cab binary
